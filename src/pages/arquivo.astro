---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';
import { url, formatDay, isoDay, year } from '../lib/util';
const posts = await getPosts();
const anos = new Map<number, typeof posts>();
for (const p of posts) { const a = year(p.data.date); anos.set(a, [...(anos.get(a) ?? []), p]); }
---
<BaseLayout titulo="Arquivo" descricao="Todos os escritos, do mais recente ao mais antigo.">
  <section class="lista">
    <h1>Arquivo</h1>
    <p class="meta">{posts.length} escritos. <a href={url('tags/')}>Ver por marcador</a></p>
    {[...anos.entries()].map(([ano, lista]) => (
      <section class="ano">
        <h2>{ano}</h2>
        <ul>
          {lista.map((p) => (
            <li>
              <time datetime={isoDay(p.data.date)}>{formatDay(p.data.date)}</time>
              <a href={url(`escritos/${p.id}/`)}>{p.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>
